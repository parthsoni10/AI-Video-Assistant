# ── LLM & NLP APIs ──────────────────────────────────────────────────────────
# Required for Summarization, Extraction, and RAG chat.
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Speech-to-Text APIs ─────────────────────────────────────────────────────
# Required for Hinglish transcription/translation. Get an API key from Sarvam AI.
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: The Sarvam STT model to use (default is saaras:v2.5)
SARVAM_STT_MODEL=saaras:v2.5

# Optional: The local Whisper model to use for English transcription (tiny, base, small, medium, large, etc.)
# Defaults to "small"
WHISPER_MODEL=small
